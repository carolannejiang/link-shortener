# Copy this file to .env.local and fill in the values for local development.
# In production, Vercel sets the Redis values automatically when you connect a
# Redis database, and you add ADMIN_PASSWORD yourself in Project Settings.

# A long password you choose. The only thing protecting your links.
ADMIN_PASSWORD=

# The domain your short links live on, e.g. carolanne.link (no scheme). Shown
# as the page title and admin header. Build-time (NEXT_PUBLIC_*): set it in
# Vercel's env settings and redeploy. Defaults to localhost:3000 if unset.
NEXT_PUBLIC_SITE_HOST=

# From Vercel Storage → your Redis database → ".env.local" tab. Copy both.
# (Some providers name these UPSTASH_REDIS_REST_URL / _TOKEN — either works.)
# No database? Run `node scripts/local-redis.mjs` and use:
#   KV_REST_API_URL=http://127.0.0.1:8079
#   KV_REST_API_TOKEN=anything
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: extra domains for printed QR codes, comma-separated bare hosts
# (e.g. mybrand.com). Attach each one to this same Vercel project first —
# the redirect proxy resolves the same slugs on any domain. The dashboard's
# QR panel then gets a toggle to encode links on these instead. Build-time
# (NEXT_PUBLIC_*): set it in Vercel's env settings and redeploy.
# NEXT_PUBLIC_QR_DOMAINS=

# Passkeys / Touch ID (WebAuthn) work automatically — they're bound to whatever
# domain you load the site from. Only set these to override that, e.g. if the
# app sits behind a proxy whose host header doesn't match the public URL.
#   RP_ID     = the bare domain, e.g. carolanne.link
#   RP_ORIGIN = the full origin, e.g. https://carolanne.link
# RP_ID=
# RP_ORIGIN=
